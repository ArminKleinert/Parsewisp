(* https://esolangs.org/wiki/Poetic_(esolang) *)

S = <ws>? exp*

<exp> = i1 | i2 | i3 | i4 | i5 | i6 | i7 | i8 | i9 | i10 | imore

i1    = <char>       <ws>
i2    = <char> {2}   <ws>
i3    = <char> {3}   <ws>
i4    = <char> {4}   <ws>
i5    = <char> {5}   <ws>
i6    = <char> {6}   <ws>
i7    = <char> {7}   <ws>
i8    = <char> {8}   <ws>
i9    = <char> {9}   <ws>
i10   = <char> {10}  <ws>
imore = char   {11,} <ws>
char  = #"[A-Za-z0-9\']"
ws    = #"[^A-Za-z0-9\']"+ | EOF